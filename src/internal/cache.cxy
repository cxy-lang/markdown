module markdown_cache

import { Path, PathLike, cast, exists, mkdirs, isfile, withNullTermination } from "stdlib/path.cxy"
import { Stat, stat, IOError } from "stdlib/os.cxy"
import { MarkdownError } from "./common.cxy"

import "sys/stat.h" as sysstat
import "unistd.h"  as unistd

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

func fileMtime(path: __string): u64 {
    var s = Stat{}
    if withNullTermination[i32](&path, (p: ^const char) => stat(p !: string, ptrof s)) != 0 {
        return 0`u64
    }
    return <u64>s.#{StatField!("m")}.tv_sec
}

// ---------------------------------------------------------------------------
// MdCache
//
// Translates a source markdown path to a deterministic HTML output path
// under a configurable cache directory, and decides whether the cached
// output is still valid by comparing source and output mtimes.
//
// Directory layout:
//   <cacheDir>/
//     <mirrored/source/path>.html
//
// Example:
//   source:  /home/user/docs/guide.md
//   cache:   .markdown/home/user/docs/guide.html
//
// For relative source paths the mirror is relative too:
//   source:  src/blog/intro.md
//   cache:   .markdown/src/blog/intro.html
// ---------------------------------------------------------------------------

pub class MdCache {
    - _cacheDir: Path

    func `init`(cacheDir: PathLike) {
        _cacheDir = cast[Path](&cacheDir)
    }

    /// Return the cache output path for a given source path.
    /// The extension is replaced with .html and the full path
    /// is mirrored under the cache directory.
    const func outputPath(srcPath: __string): Path {
        // Strip leading '/' so Path./ concatenation works correctly
        var rel = srcPath
        if !rel.empty() && rel.[0] == '/' as char {
            rel = rel.substr(1)
        }

        // Replace extension with .html
        var dotPos = rel.rfind(".")
        if dotPos {
            rel = rel.substr(0, <i64>*dotPos)
        }

        return _cacheDir / f"{rel}.html"
    }

    /// Returns true if the cached HTML for srcPath is still valid:
    ///   - the output file exists, AND
    ///   - its mtime is strictly newer than the source file's mtime.
    const func isValid(srcPath: __string): bool {
        var outPath = outputPath(srcPath)
        var outStr  = outPath.__str()

        if !isfile(outPath) {
            return false
        }

        var srcMtime = fileMtime(srcPath)
        var outMtime = fileMtime(outStr)

        // If we can't stat the source, consider cache invalid
        if srcMtime == 0 {
            return false
        }

        return outMtime > srcMtime
    }

    /// Ensure the directory containing the output path exists.
    func ensureDir(srcPath: __string): !void {
        var out    = outputPath(srcPath)
        var outStr = out.__str()

        // Find the parent directory
        var sep = outStr.rfind("/")
        if sep {
            var dir = outStr.substr(0, <i64>*sep)
            if !exists(dir) {
                mkdirs(dir)
            }
        }
    }

    @inline
    const func cacheDir() => &_cacheDir
}
